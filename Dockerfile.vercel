FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-audio.txt ./
RUN python3 -m venv /opt/audio && /opt/audio/bin/pip install --no-cache-dir -r requirements-audio.txt
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.mjs cloud-audio.mjs remote-backend.mjs stream-growing.mjs ./
COPY dist ./dist
ENV NODE_ENV=production LA_CONTAINER=1 LA_CLOUD_AUDIO=1 LA_PYTHON=/opt/audio/bin/python LA_FFMPEG=/usr/bin/ffmpeg PORT=80
EXPOSE 80
CMD ["node", "server.mjs"]
